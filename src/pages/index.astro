---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/navigation/TopBar.astro';
import Navbar from '../components/navigation/Navbar.astro';
import Hero from '../components/hero/Hero.astro';
import WhyJoin from '../components/why-join/WhyJoin.astro';
import EventFlow from '../components/event-flow/EventFlow.astro';
import Partners from '../components/partners/Partners.astro';
import PastEditions from '../components/past-editions/PastEditions.astro';
import Merchandise from '../components/merchandise/Merchandise.astro';
import Register from '../components/register/Register.astro';
import '../styles/sections.css';
import styles from './index.module.css';
---

<Layout title="STEM 2026 | Kompetisi Teknologi dan Rekayasa Tingkat Nasional">
	<TopBar />
	<main class={styles.pageContainer}>
		<Hero />
		<WhyJoin />
		<EventFlow />
		<Partners />
		<PastEditions />
		<Merchandise />
		<Register />
	</main>
	<Navbar />
</Layout>

<script>
	import { initScrollSpy } from '../scripts/scrollSpy';
	import { initScrollAnimations } from '../scripts/scrollAnimations';
	import { initCountdown } from '../scripts/countdown';

	function initPage() {
		initScrollSpy();
		initScrollAnimations();
		initCountdown();
	}
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initPage, { once: true });
	} else {
		initPage();
	}
</script>
