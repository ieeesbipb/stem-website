---
import { navItems } from '../../data/navigation';
import styles from './Navbar.module.css';
---

<nav class={styles.bottomNav} aria-label="Navigasi utama" data-bottom-nav>
	<div class={styles.navLinksScroll}>
		{
			navItems.map((item) => (
				<a
					href={item.href}
					id={item.id}
					class={styles.navItem} data-cursor-text="Lihat Bagian Ini ⤵"
					data-active={item.active ? "blue" : undefined}
					aria-current={item.active ? "page" : undefined}
				>
					<span class={styles.activeIndicator} aria-hidden="true">
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
							<circle cx="6" cy="6" r="5" stroke="#08111E" stroke-width="1.8" />
							<circle cx="6" cy="6" r="2.2" fill="#08111E" />
						</svg>
					</span>
					<span class={styles.navLabel}>{item.label}</span>
				</a>
			))
		}
	</div>

	<a href="https://www.instagram.com/stem.ipb/" class:list={[styles.navItem, styles.instagramLink]} target="_blank" rel="noopener noreferrer" aria-label="Instagram @stem.ipb — buka di tab baru" data-cursor-text="Lihat Instagram STEM ↗">
		<span class={styles.navLabel}>@stem.ipb</span>
	</a>
	<a href="#register" class={styles.navCta} id="bottom-register-cta" aria-label="Daftar Sekarang" data-cursor-text="Ikuti STEM 2026 ↗">
		<span class={styles.ctaLabel}>Daftar Sekarang</span>
		<span class={styles.ctaArrowBox} aria-hidden="true">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square">
				<path d="M7 17L17 7" />
				<path d="M7 7h10v10" />
			</svg>
		</span>
	</a>
</nav>
