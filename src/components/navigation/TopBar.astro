---
import styles from './TopBar.module.css';
---

<header class={styles.topBar} data-top-bar>
	<div class={styles.topLeft}>
		<a href="/" class={styles.brandLink} aria-label="Beranda STEM 2026" data-brand-link>
			<img src="/brand/logo-stem.png" class={styles.brandLogo} alt="STEM" width="728" height="277" />
		</a>
	</div>
	<div class={styles.topRight}>
		<span class={styles.dateTag}>
			<span class={styles.tagBracket}>&lt;date&gt;</span>
			<span class={styles.dateValue}>22 November 2026</span>
			<span class={styles.tagBracket}>&lt;/date&gt;</span>
		</span>
	</div>
</header>
