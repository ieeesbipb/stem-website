---
import Arrow from '../shared/Arrow.astro';
---
<section id="partners" class="partners new-section" aria-labelledby="partners-title">
  <div class="section-inner partner-inner">
    <h2 id="partners-title" class="section-heading" data-reveal>Mitra</h2>
    <div class="partner-grid" aria-label="Mitra akan segera diumumkan">
      {Array.from({ length: 5 }, (_, i) => (
        <div data-cursor-text="Mitra Resmi 🤝" class:list={['partner-tile', { 'partner-featured': i === 0 }]} data-reveal style={`--reveal-delay: ${i * 65}ms`} data-cursor-text="Mitra Resmi 🤝">
          <span class="partner-name">Nama Mitra</span><span class="partner-logo">Logo Mitra</span>
        </div>
      ))}
    </div>
    <details class="sponsor-details" data-reveal>
      <summary class="section-cta" data-cursor-text="Jadi Mitra Kami ↗"><span>Jadi sponsor</span><span class="arrow-box"><Arrow /></span></summary>
      <p>Peluang kerja sama sponsor dan informasi kontak akan segera diumumkan. Nantikan kabar terbaru dari STEM 2026.</p>
    </details>
  </div>
</section>
