---
import OdometerCountdown from './OdometerCountdown.astro';
import styles from './HeroContent.module.css';
---

<div class={styles.heroLeft}>
	<!-- Screen 1: Hero Intro -->
	<section class:list={[styles.screenPane, styles.heroScreen]} id="hero">
		<div class={styles.heroContent}>
			<div class={styles.heroHeaderBlock}>
				<div class={styles.titleGroup}>
					<h1 class={styles.titleMain}>
						<span class={styles.wordMask}><span class={styles.word} style="--i: 0">STEM</span></span>
						<span class={styles.wordMask}><span class={styles.word} style="--i: 1">2026</span></span>
					</h1>
					<div class={styles.titleSub}>
						<span class={styles.wordMask}><span class={styles.word} style="--i: 2">by</span></span>
						<span class={styles.wordMask}><span class={styles.word} style="--i: 3">IEEE</span></span>
						<span class={styles.wordMask}><span class={styles.word} style="--i: 4">SB</span></span>
						<span class={styles.wordMask}><span class={styles.word} style="--i: 5">IPB</span></span>
					</div>
				</div>

				<OdometerCountdown dateText="22 November 2026" />

				<div class:list={[styles.actionRow, 'float-up']} style="--delay: 0.38s; --float-y: 60px;">
					<a href="#register" class={styles.heroBtn} id="hero-register-btn">
						<span class={styles.btnText}>Register Now</span>
						<span class={styles.btnIcon} aria-hidden="true">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square">
								<path d="M7 17L17 7" />
								<path d="M7 7h10v10" />
							</svg>
						</span>
					</a>

					<p class={styles.targetAudience}>
						For High School students and 1st year of University
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Screen 2: Overview Content -->
	<section class:list={[styles.screenPane, styles.overviewScreen]} id="overview">
		<div class={styles.overviewContent}>
			<div class={styles.overviewBlock} data-animate="float-up" style="--delay: 0s; --float-y: 90px;">
				<h2 class={styles.overviewHeading}>What is STEM 2026?</h2>
				<p class={styles.overviewLead}>
					STEM 2026 is a flagship program of IEEE Student Branch IPB University, built to foster knowledge and technological engineering for real-world applications.
				</p>
			</div>

			<div class={styles.overviewBlock} data-animate="float-up" style="--delay: 0.16s; --float-y: 90px;">
				<h2 class={styles.overviewHeading}>“From Reactive to Proactive”</h2>
				<p class={styles.overviewLead}>
					This year's theme focuses on shifting from post-disaster response to proactive risk reduction. Through Internet of Things (IoT) technologies, smart sensor networks, and early warning systems, participants are challenged to develop practical engineering solutions that help Indonesia predict, monitor, and mitigate natural disasters before they strike.
				</p>
			</div>

			<div class={styles.overviewActions} data-animate="float-up" style="--delay: 0.32s; --float-y: 70px;">
				<a href="#guidebook" class={styles.guidebookBtn} id="download-guidebook-btn">
					Download Guidebook
				</a>
			</div>
		</div>
	</section>
</div>
