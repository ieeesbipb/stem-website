---
import styles from './HeroVisual.module.css';
---

<div class={styles.heroRight}>
	<!-- Corner Icons -->
	<div class:list={[styles.cornerIcon, styles.cornerTopLeft]} title="Peringatan STEM">
		<img
			src="/Warning Triangle Icon (Top Left Corner).png"
			alt="Ikon segitiga peringatan"
			width="64"
			height="64"
			loading="eager"
		/>
	</div>

	<div class:list={[styles.cornerIcon, styles.cornerTopRight]} title="Teknologi Drone">
		<img
			src="/Drone Icon (Top Right Corner).png"
			alt="Ikon jaringan drone"
			width="64"
			height="64"
			loading="eager"
		/>
	</div>

	<div class:list={[styles.cornerIcon, styles.cornerBottomLeft]} title="Perangkat Komputasi">
		<img
			src="/Microchip Icon (Bottom Left Corner).png"
			alt="Ikon microchip"
			width="64"
			height="64"
			loading="eager"
		/>
	</div>

	<div class:list={[styles.cornerIcon, styles.cornerBottomRight]} title="Jaringan Nirkabel">
		<img
			src="/Signal Icon (Bottom Right Corner).png"
			alt="Ikon gelombang sinyal"
			width="64"
			height="64"
			loading="eager"
		/>
	</div>

	<!-- Central Stage with IoT Mascot GIF -->
	<div class={styles.stageContainer}>
		<div class={styles.visualStage}>
			<div class={styles.gifWrapper}>
				<img
					src="/gif/gifiot.gif"
					alt="Animasi Maskot IoT STEM 2026"
					class={styles.heroGifAsset}
					loading="eager"
				/>
			</div>
		</div>
	</div>
</div>
