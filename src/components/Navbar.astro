---
interface NavItem {
	label: string;
	href: string;
	active?: boolean;
	id?: string;
}

const navItems: NavItem[] = [
	{ label: "Overview", href: "#overview", active: true, id: "nav-overview" },
	{ label: "Why Join", href: "#why-join", id: "nav-why-join" },
	{ label: "Event Flow", href: "#event-flow", id: "nav-event-flow" },
	{ label: "Speakers", href: "#speakers", id: "nav-speakers" },
	{ label: "Partners", href: "#partners", id: "nav-partners" },
	{ label: "FAQ", href: "#faq", id: "nav-faq" },
];
---

<nav class="bottom-nav" aria-label="Main Navigation">
	<div class="nav-links-scroll">
		{
			navItems.map((item) => (
				<a
					href={item.href}
					id={item.id}
					class:list={["nav-item", { active: item.active }]}
					aria-current={item.active ? "page" : undefined}
				>
					<span class="active-indicator" aria-hidden="true">
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
							<circle cx="6" cy="6" r="5" stroke="#08111E" stroke-width="1.8" />
							<circle cx="6" cy="6" r="2.2" fill="#08111E" />
						</svg>
					</span>
					<span class="nav-label">{item.label}</span>
				</a>
			))
		}
	</div>

	<a href="#register" class="nav-cta" id="bottom-register-cta">
		<span class="cta-label">Register Now</span>
		<span class="cta-arrow-box" aria-hidden="true">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square">
				<path d="M7 17L17 7" />
				<path d="M7 7h10v10" />
			</svg>
		</span>
	</a>
</nav>

<style>
	.bottom-nav {
		position: fixed;
		bottom: 0;
		left: 0;
		height: 64px;
		width: 100%;
		border-top: 2px solid var(--navy-dark);
		background-color: var(--bg-light);
		display: flex;
		align-items: stretch;
		z-index: 50;
	}

	.nav-links-scroll {
		display: flex;
		align-items: stretch;
		overflow-x: auto;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.nav-links-scroll::-webkit-scrollbar {
		display: none;
	}

	.nav-item {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 0 28px;
		border-right: 2px solid var(--navy-dark);
		background-color: #FFFFFF;
		color: var(--navy-dark);
		font-size: 14px;
		font-weight: 700;
		white-space: nowrap;
		text-decoration: none;
		transition: background-color 0.2s ease, color 0.2s ease;
		user-select: none;
	}

	.nav-item:hover:not(.active):not(.active-yellow) {
		background-color: var(--tab-hover);
	}

	.nav-item.active {
		background-color: var(--blue-accent);
		color: var(--navy-dark);
	}

	.nav-item.active-yellow {
		background-color: #FFD600 !important;
		color: var(--navy-dark) !important;
	}

	.active-indicator {
		display: none;
		align-items: center;
		justify-content: center;
		width: 12px;
		height: 12px;
	}

	.nav-item.active .active-indicator,
	.nav-item.active-yellow .active-indicator {
		display: flex;
	}

	.nav-label {
		letter-spacing: -0.01em;
	}

	/* Right CTA Area */
	.nav-cta {
		flex: 1;
		display: flex;
		align-items: stretch;
		justify-content: space-between;
		background-color: var(--navy-dark);
		color: #FFFFFF;
		text-decoration: none;
		transition: opacity 0.15s ease;
		min-width: 200px;
	}

	.cta-label {
		display: flex;
		align-items: center;
		padding-left: 32px;
		font-size: 15px;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.cta-arrow-box {
		width: 64px;
		height: 64px;
		min-width: 64px;
		background-color: var(--blue-accent);
		color: var(--navy-dark);
		border-left: 2px solid var(--navy-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background-color 0.15s ease, transform 0.15s ease;
	}

	.nav-cta:hover .cta-arrow-box {
		background-color: var(--blue-accent-hover);
	}

	.nav-cta:hover .cta-arrow-box svg {
		transform: translate(2px, -2px);
	}

	.cta-arrow-box svg {
		transition: transform 0.15s ease;
	}

	@media (max-width: 1024px) {
		.nav-item {
			padding: 0 20px;
			font-size: 13px;
		}

		.cta-label {
			padding-left: 20px;
			font-size: 14px;
		}
	}

	@media (max-width: 640px) {
		.bottom-nav {
			height: 56px;
		}

		.nav-item {
			padding: 0 16px;
			font-size: 13px;
		}

		.cta-label {
			display: none;
		}

		.cta-arrow-box {
			width: 56px;
			height: 56px;
			min-width: 56px;
		}

		.nav-cta {
			flex: 0 0 auto;
			min-width: unset;
		}
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const topBar = document.querySelector('.top-bar');
		const navOverview = document.getElementById('nav-overview');
		const navWhyJoin = document.getElementById('nav-why-join');
		const whyJoinSection = document.getElementById('why-join');
		const heroSection = document.getElementById('hero');
		const overviewSection = document.getElementById('overview');
		const brandLink = document.querySelector('.brand-link');

		// Smooth click navigation
		if (navOverview && overviewSection) {
			navOverview.addEventListener('click', (e) => {
				e.preventDefault();
				overviewSection.scrollIntoView({ behavior: 'smooth' });
			});
		}

		if (navWhyJoin && whyJoinSection) {
			navWhyJoin.addEventListener('click', (e) => {
				e.preventDefault();
				whyJoinSection.scrollIntoView({ behavior: 'smooth' });
			});
		}

		if (brandLink && heroSection) {
			brandLink.addEventListener('click', (e) => {
				e.preventDefault();
				heroSection.scrollIntoView({ behavior: 'smooth' });
			});
		}

		// Scroll Observer for active tab and top-bar dark mode
		if (whyJoinSection && navOverview && navWhyJoin) {
			const updateStateOnScroll = () => {
				const rect = whyJoinSection.getBoundingClientRect();
				// If why-join top is near or above the middle of viewport
				const inWhyJoin = rect.top <= 200 && rect.bottom > 150;

				if (inWhyJoin) {
					// Why Join active state
					navOverview.classList.remove('active');
					navWhyJoin.classList.add('active-yellow');
					if (topBar) topBar.classList.add('theme-dark');
				} else {
					// Overview / Hero active state
					navWhyJoin.classList.remove('active-yellow');
					navOverview.classList.add('active');
					if (topBar) topBar.classList.remove('theme-dark');
				}
			};

			window.addEventListener('scroll', updateStateOnScroll, { passive: true });
			updateStateOnScroll();
		}
	});
</script>
