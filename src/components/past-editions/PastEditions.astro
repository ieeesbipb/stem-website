---
import Arrow from '../shared/Arrow.astro';

const photos2025 = Array.from({ length: 10 }, (_, i) =>
  `/past-editions/2025/${String(i + 1).padStart(2, '0')}`
);
---
<section id="past-editions" class="past-editions new-section" aria-labelledby="past-title">
  <div class="section-inner">
    <header class="centered-heading" data-reveal>
      <h2 id="past-title" class="section-heading">Kilas Balik STEM</h2>
      <p>Kenang kembali tema dan momen dari penyelenggaraan STEM sebelumnya.</p>
    </header>
    <div class="edition-grid">
      <article class="edition-card" data-cursor-text="Kilas Balik 2025 ⏪">
        <span class="edition-badge" data-reveal style="--reveal-delay: 0ms">2025</span>
        <div class="edition-collage" data-photo-reveal aria-label="Kolase foto STEM 2025">
          {photos2025.map((src, i) => (
            <div class="edition-photo" style={`--photo-i: ${i}`}>
              <img
                src={`${src}-1280.webp`}
                srcset={`${src}-640.webp 640w, ${src}-1280.webp 1280w`}
                sizes="(max-width: 640px) 70vw, (max-width: 1024px) 40vw, 30vw"
                width="1280"
                height="853"
                alt={`Foto STEM 2025 ke-${i + 1}`}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
        <p class="edition-description" data-reveal style="--reveal-delay: 600ms">STEM 2025 mengangkat tema &ldquo;Preparing Young Generation Resources for an Inclusive and Just Clean Energy Transition&rdquo;</p>
        <div class="edition-footer" data-reveal style="--reveal-delay: 750ms">
          <p class="edition-meta">8 November 2025, IPB University</p>
          <a class="edition-more section-cta dark-cta" data-cursor-text="Kilas Balik 2025 ⏪" href="https://instagram.com/stem.ipb" target="_blank" rel="noopener noreferrer" aria-label="Lihat selengkapnya di Instagram STEM (buka di tab baru)">
            <span>Lihat selengkapnya</span><span class="arrow-box"><Arrow /></span>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>
