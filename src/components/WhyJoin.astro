---
interface CardData {
	id: string;
	num: string;
	badgeBg: string;
	badgeColor: string;
	text: string;
	stagger?: boolean;
}

const cards: CardData[] = [
	{
		id: "card-01",
		num: "01",
		badgeBg: "#48D597",
		badgeColor: "#08111E",
		text: "Gain new knowledge and experience",
	},
	{
		id: "card-02",
		num: "02",
		badgeBg: "#FF5500",
		badgeColor: "#FFFFFF",
		text: "Join seminars and a hands-on workshop",
		stagger: true,
	},
	{
		id: "card-03",
		num: "03",
		badgeBg: "#2B00FF",
		badgeColor: "#FFFFFF",
		text: "Earn an e-certificate",
	},
	{
		id: "card-04",
		num: "04",
		badgeBg: "#E0B8F6",
		badgeColor: "#08111E",
		text: "Meet students from other schools",
	},
	{
		id: "card-05",
		num: "05",
		badgeBg: "#FFD000",
		badgeColor: "#08111E",
		text: "Network with IEEE SB IPB officers",
		stagger: true,
	},
	{
		id: "card-06",
		num: "06",
		badgeBg: "#55A8FF",
		badgeColor: "#08111E",
		text: "Possible internship opportunity",
	},
];
---

<section class="why-join-section" id="why-join">
	<!-- Top Framing Accent Bar -->
	<div class="accent-bar-top" aria-hidden="true"></div>

	<!-- Left Framing Accent Bar -->
	<div class="accent-bar-left" aria-hidden="true">
		<div class="accent-corner-square"></div>
	</div>

	<!-- Section Container -->
	<div class="why-join-container">
		<!-- Header -->
		<header class="section-header">
			<h2 class="section-title">Why join STEM 2026?</h2>
			<p class="section-subtitle">
				Learn, build and connect with the next generation of tech innovators.
			</p>
		</header>

		<!-- 3-Column Staggered Grid -->
		<div class="cards-grid">
			{
				cards.map((card) => (
					<div class:list={["card-wrapper", { "card-staggered": card.stagger }]}>
						<div class="card-outer-frame">
							<span
								class="card-badge"
								style={`background-color: ${card.badgeBg}; color: ${card.badgeColor};`}
							>
								{card.num}
							</span>
							<div class="card-inner-box">
								<p class="card-text">{card.text}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>

	<!-- Mascot Illustration (Front Facing) -->
	<div class="mascot-container" aria-hidden="true">
		<img
			src="/illust maskot 2.png"
			alt="STEM 2026 Front Mascot"
			class="why-join-mascot"
			loading="lazy"
		/>
	</div>
</section>

<style>
	.why-join-section {
		min-height: calc(100vh - 120px);
		width: 100%;
		position: relative;
		overflow: hidden;
		background-color: #051020;
		color: #FFFFFF;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 5rem 6% 6.5rem calc(6% + 24px);
		box-sizing: border-box;
		border-bottom: 2px solid #08111E;
	}

	/* Top Horizontal Framing Accent Bar */
	.accent-bar-top {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 14px;
		background-color: #2B5B9E;
		z-index: 2;
	}

	/* Left Vertical Framing Accent Bar */
	.accent-bar-left {
		position: absolute;
		top: 0;
		left: 0;
		width: 24px;
		height: 100%;
		background-color: #2B5B9E;
		z-index: 3;
	}

	/* Corner Intersection Accent Square */
	.accent-corner-square {
		position: absolute;
		top: 0;
		left: 0;
		width: 24px;
		height: 14px;
		background-color: #3C78C8;
	}

	/* Section Content Container */
	.why-join-container {
		max-width: 1180px;
		width: 100%;
		position: relative;
		z-index: 4;
	}

	/* Centered Header */
	.section-header {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.section-title {
		color: #FFFFFF;
		font-size: clamp(2.3rem, 4.5vw, 3.75rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		margin: 0 0 0.75rem 0;
		line-height: 1.1;
	}

	.section-subtitle {
		color: #D0D7E2;
		font-size: 1.05rem;
		font-weight: 400;
		margin: 0;
		letter-spacing: -0.01em;
	}

	/* 3-Column Staggered Grid */
	.cards-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.25rem 2.5rem;
		width: 100%;
		position: relative;
	}

	.card-wrapper {
		display: flex;
		flex-direction: column;
		transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1);
	}

	/* Column 2 Staggered Offset */
	@media (min-width: 1025px) {
		.card-staggered {
			transform: translateY(36px);
		}

		.card-staggered:hover {
			transform: translateY(32px);
		}

		.card-wrapper:not(.card-staggered):hover {
			transform: translateY(-4px);
		}
	}

	/* Card Outer Frame with L-shaped Accent Border */
	.card-outer-frame {
		position: relative;
		border: 1.5px solid #3A4659;
		border-left: 14px solid #3A4659;
		border-top: 10px solid #3A4659;
		padding: 14px 16px 16px 16px;
		background-color: transparent;
		box-sizing: border-box;
		box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
	}

	/* Top-Left Overlapping Badge */
	.card-badge {
		position: absolute;
		top: -14px;
		left: 14px;
		z-index: 5;
		padding: 4px 10px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		font-weight: 800;
		border: 1.5px solid #051020;
		box-shadow: 1.5px 1.5px 0px #051020;
		line-height: 1;
		user-select: none;
	}

	/* Inner White Card Box */
	.card-inner-box {
		background-color: #F9F9FB;
		color: #08111E;
		padding: 26px 24px;
		min-height: 105px;
		display: flex;
		align-items: center;
		border: 1.5px solid #051020;
		box-sizing: border-box;
	}

	.card-text {
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.35;
		color: #08111E;
		margin: 0;
		letter-spacing: -0.01em;
	}

	/* Bottom-Right Mascot */
	.mascot-container {
		position: absolute;
		right: 3%;
		bottom: 3.5%;
		width: clamp(130px, 12vw, 175px);
		z-index: 10;
		pointer-events: none;
	}

	.why-join-mascot {
		width: 100%;
		height: auto;
		display: block;
		filter: drop-shadow(-4px 8px 14px rgba(0, 0, 0, 0.45));
		animation: mascotBreathe 4s ease-in-out infinite;
	}

	@keyframes mascotBreathe {
		0%, 100% {
			transform: translateY(0px) scale(1);
		}
		50% {
			transform: translateY(-5px) scale(1.02);
		}
	}

	/* Responsive Styling */
	@media (max-width: 1024px) {
		.why-join-section {
			padding: 4.5rem 5% 5rem calc(5% + 24px);
			min-height: auto;
		}

		.cards-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 2rem;
		}

		.card-staggered {
			transform: none;
		}

		.mascot-container {
			right: 2%;
			bottom: 2%;
			width: 120px;
			opacity: 0.85;
		}
	}

	@media (max-width: 720px) {
		.why-join-section {
			padding: 3.5rem 1.25rem 4rem calc(1.25rem + 16px);
		}

		.accent-bar-left {
			width: 16px;
		}

		.accent-corner-square {
			width: 16px;
		}

		.cards-grid {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.section-header {
			margin-bottom: 2.5rem;
		}

		.card-inner-box {
			padding: 20px 18px;
			min-height: 85px;
		}

		.card-text {
			font-size: 1.05rem;
		}

		.mascot-container {
			display: none;
		}
	}
</style>
