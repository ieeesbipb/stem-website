---
const events = [
  { title: 'Seminar 1', type: 'Seminar', color: '#FFD516' },
  { title: 'Seminar 2', type: 'Seminar', color: '#56DA9F' },
  { title: 'Workshop 1', type: 'Workshop', color: '#4EA5FF' },
  { title: 'Workshop 2', type: 'Workshop', color: '#FFD516' },
  { title: 'Seminar 3', type: 'Seminar', color: '#56DA9F' },
  { title: 'Closing', type: 'Closing', color: '#4EA5FF' },
];
---
<section id="event-flow" class="event-flow new-section" aria-labelledby="event-flow-title">
  <div class="section-inner flow-inner">
    <h2 id="event-flow-title" class="section-heading" data-reveal>Event Flow</h2>
    <div class="event-grid">
      {events.map((event, index) => (
        <article class="event-card" style={`--card-color: ${event.color};`} data-col={index % 2} data-title={event.title}>
          <span class="event-badge">{event.type}</span>
          <div class="event-titlebar">
            <div class="event-titlebar-inner">
              <span class="event-icon-box" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 28 28" fill="currentColor">
                  <circle cx="5" cy="14" r="1.35" />
                  <circle cx="8.5" cy="14" r="1.35" />
                  <circle cx="12" cy="14" r="1.35" />
                  <circle cx="15.5" cy="14" r="1.35" />
                  <circle cx="19" cy="14" r="1.35" />
                  <circle cx="22.5" cy="14" r="1.35" />
                  <circle cx="15.5" cy="7.5" r="1.35" />
                  <circle cx="19" cy="10.8" r="1.35" />
                  <circle cx="15.5" cy="20.5" r="1.35" />
                  <circle cx="19" cy="17.2" r="1.35" />
                </svg>
              </span>
              <h3 class="event-title-text">{event.title}</h3>
            </div>
          </div>
          <div class="event-illustration" aria-hidden="true"></div>
          <div class="event-description">
            <p><strong>{event.type}:</strong> Topic to be announced. Explore emerging tech, IoT, and engineering solutions.</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
