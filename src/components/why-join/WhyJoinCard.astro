---
import type { WhyJoinCardData } from '../../data/whyJoin';
import styles from './WhyJoinCard.module.css';

interface Props {
	card: WhyJoinCardData;
}

const { card } = Astro.props;
---

<article class={styles.cardOuter} aria-labelledby={`${card.id}-title`} data-cursor-text="Temukan Manfaat ⚡">
	<h3
		class={styles.cardBadge}
		id={`${card.id}-title`}
		style={`background-color: ${card.badgeBg}; color: ${card.badgeColor};`}
	>
		{card.title}
	</h3>
	<div class={styles.cardInner}>
		<p class={styles.cardText}>{card.text}</p>
	</div>
</article>
