---
import { whyJoinColumns } from '../../data/whyJoin';
import WhyJoinCard from './WhyJoinCard.astro';
import styles from './WhyJoin.module.css';
---

<section class={styles.whyJoinSection} id="why-join">
	<!-- Section Container -->
	<div class={styles.whyJoinContainer}>
		<!-- Header -->
		<header class={styles.sectionHeader} data-animate="slide-up">
			<h2 class={styles.sectionTitle}>
				<span class={styles.wordMask}><span class={styles.word} style="--i: 0">Why</span></span>
				<span class={styles.wordMask}><span class={styles.word} style="--i: 1">join</span></span>
				<span class={styles.wordMask}><span class={styles.word} style="--i: 2">STEM</span></span>
				<span class={styles.wordMask}><span class={styles.word} style="--i: 3">2026?</span></span>
			</h2>
			<p
				class={styles.sectionSubtitle}
				data-animate="float-up"
				style="--delay: 0.28s; --float-y: 50px;"
			>
				Learn, build and connect with the next generation of tech innovators.
			</p>
		</header>

		<!-- 3 Columns Parallax Grid -->
		<div class={styles.columnsContainer} data-why-join-grid>
			{
				whyJoinColumns.map((columnCards, colIdx) => (
					<div
						class={styles.column}
						data-column-index={colIdx}
					>
						{columnCards.map((card) => (
							<div class={styles.cardItem}>
								<WhyJoinCard card={card} />
							</div>
						))}
					</div>
				))
			}
		</div>
	</div>
</section>
