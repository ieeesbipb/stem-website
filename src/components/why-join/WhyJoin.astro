---
import { whyJoinColumns } from '../../data/whyJoin';
import WhyJoinCard from './WhyJoinCard.astro';
import styles from './WhyJoin.module.css';
---

<section class={styles.whyJoinSection} id="why-join">
	<!-- Top Framing Accent Bar -->
	<div class={styles.accentBarTop} aria-hidden="true" />

	<!-- Left Framing Accent Bar -->
	<div class={styles.accentBarLeft} aria-hidden="true">
		<div class={styles.accentCornerSquare} />
	</div>

	<!-- Section Container -->
	<div class={styles.whyJoinContainer}>
		<!-- Header -->
		<header class={styles.sectionHeader}>
			<h2 class={styles.sectionTitle}>Why join STEM 2026?</h2>
			<p class={styles.sectionSubtitle}>
				Learn, build and connect with the next generation of tech innovators.
			</p>
		</header>

		<!-- 3 Columns Parallax Grid -->
		<div class={styles.columnsContainer} data-why-join-grid>
			{
				whyJoinColumns.map((columnCards, colIdx) => (
					<div
						class={styles.column}
						data-column-index={colIdx}
					>
						{columnCards.map((card) => (
							<div class={styles.cardItem}>
								<WhyJoinCard card={card} />
							</div>
						))}
					</div>
				))
			}
		</div>
	</div>
</section>
